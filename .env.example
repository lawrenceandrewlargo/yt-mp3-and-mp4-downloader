DATABASE_URL=file:./data/app.db
DATABASE_AUTH_TOKEN=
# auto chooses local on your computer and metadata on Vercel
MEDIA_EXECUTION_PROVIDER=auto
DOWNLOAD_DIRECTORY=./downloads
TEMP_DIRECTORY=./data/tmp
DOWNLOAD_CONCURRENCY=2
# Trusted administrator configuration only; never accepted through HTTP
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_TIMEOUT_SECONDS=1800
# Optional cloud search/analysis: path to a packaged Linux yt-dlp binary.
# No media download or FFmpeg execution is enabled in cloud mode.
CLOUD_YTDLP_PATH=
